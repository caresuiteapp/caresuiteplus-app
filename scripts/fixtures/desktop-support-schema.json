ype":"text"},{"default":null,"name":"address_supplement","type":"text"},{"default":null,"name":"cost_center","type":"text"}]},"triggers":[{"definition":"CREATE OR REPLACE FUNCTION public.create_audit_log()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\r\ndeclare\r\n  v_tenant_id uuid;\r\n  v_profile_id uuid;\r\n  v_action public.audit_action_type;\r\n  v_record_id uuid;\r\nbegin\r\n  v_profile_id := public.current_profile_id();\r\n\r\n  if tg_op = 'INSERT' then\r\n    v_action := 'create';\r\n    v_record_id := new.id;\r\n\r\n    v_tenant_id := nullif(to_jsonb(new)->>'tenant_id', '')::uuid;\r\n\r\n    insert into public.audit_logs (\r\n      tenant_id,\r\n      profile_id,\r\n      action,\r\n      table_name,\r\n      record_id,\r\n      title,\r\n      description,\r\n      new_data\r\n    )\r\n    values (\r\n      v_tenant_id,\r\n      v_profile_id,\r\n      v_action,\r\n      tg_table_name,\r\n      v_record_id,\r\n      'Datensatz erstellt',\r\n      'Ein Datensatz wurde in ' || tg_table_name || ' erstellt.',\r\n      to_jsonb(new)\r\n    );\r\n\r\n    return new;\r\n\r\n  elsif tg_op = 'UPDATE' then\r\n    v_action := 'update';\r\n    v_record_id := new.id;\r\n\r\n    v_tenant_id := nullif(to_jsonb(new)->>'tenant_id', '')::uuid;\r\n\r\n    insert into public.audit_logs (\r\n      tenant_id,\r\n      profile_id,\r\n      action,\r\n      table_name,\r\n      record_id,\r\n      title,\r\n      description,\r\n      old_data,\r\n      new_data\r\n    )\r\n    values (\r\n      v_tenant_id,\r\n      v_profile_id,\r\n      v_action,\r\n      tg_table_name,\r\n      v_record_id,\r\n      'Datensatz geändert',\r\n      'Ein Datensatz wurde in ' || tg_table_name || ' geändert.',\r\n      to_jsonb(old),\r\n      to_jsonb(new)\r\n    );\r\n\r\n    return new;\r\n\r\n  elsif tg_op = 'DELETE' then\r\n    v_action := 'delete';\r\n    v_record_id := old.id;\r\n\r\n    v_tenant_id := nullif(to_jsonb(old)->>'tenant_id', '')::uuid;\r\n\r\n    insert into public.audit_logs (\r\n      tenant_id,\r\n      profile_id,\r\n      action,\r\n      table_name,\r\n      record_id,\r\n      title,\r\n      description,\r\n      old_data\r\n    )\r\n    values (\r\n      v_tenant_id,\r\n      v_profile_id,\r\n      v_action,\r\n      tg_table_name,\r\n      v_record_id,\r\n      'Datensatz gelöscht',\r\n      'Ein Datensatz wurde in ' || tg_table_name || ' gelöscht.',\r\n      to_jsonb(old)\r\n    );\r\n\r\n    return old;\r\n  end if;\r\n\r\n  return null;\r\nend;\r\n$function$\n","name":"audit_tenants"},{"definition":"CREATE OR REPLACE FUNCTION public.set_updated_at()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public', 'pg_temp'\nAS $function$\r\nbegin\r\n  new.updated_at = now();\r\n  return new;\r\nend;\r\n$function$\n","name":"trg_tenants_updated_at"}]}}
