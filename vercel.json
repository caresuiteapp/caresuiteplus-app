{
  "buildCommand": "EXPO_PUBLIC_DEMO_MODE=false npx expo export --platform web && node scripts/build-public-branding-pages.mjs --output dist",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self)"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/caresuite",
      "destination": "/caresuite/index.html"
    },
    {
      "source": "/caresuite/",
      "destination": "/caresuite/index.html"
    },
    {
      "source": "/datenschutz",
      "destination": "/datenschutz/index.html"
    },
    {
      "source": "/datenschutz/",
      "destination": "/datenschutz/index.html"
    },
    {
      "source": "/nutzungsbedingungen",
      "destination": "/nutzungsbedingungen/index.html"
    },
    {
      "source": "/nutzungsbedingungen/",
      "destination": "/nutzungsbedingungen/index.html"
    },
    {
      "source": "/impressum",
      "destination": "/impressum/index.html"
    },
    {
      "source": "/impressum/",
      "destination": "/impressum/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
