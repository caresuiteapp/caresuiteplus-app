# CareSuite EAS build archive — source and required runtime assets only.
.git/
.github/
.cursor/
.expo/
.expo-*/
node_modules/

# Documentation and web GLB models are not required by native bundles.
# Native BodyMap uses ParametricBodyModel. HealthOS artwork stays available
# for the full native route tree; Metro includes only each edition's imports.
docs/
public/bodymap3d/

# Generated web/native exports and local build artifacts.
.healthos-gitbash/
dist/
dist-*/
web-build/
android/app/build/
android/.gradle/
coverage/

# Local tests, reports, screenshots and disposable audit payloads.
.audit-*/
.audit-screenshots-*/
test-out.txt
test-output.txt
vitest-output.txt
tsc-output.txt
tmp-*.txt
tmp-*.json
*.log
*.tsbuildinfo

# Local IDE and operating-system files.
.idea/
.vscode/
.DS_Store
*.orig.*

# Credentials and machine-local environment files are supplied by EAS.
.env
.env.*
.env.local
.env.*.local
.vercel/
secrets/
credentials.json
*.jks
*.keystore
*.p8
*.p12
*.pem
*.key
*.mobileprovision
